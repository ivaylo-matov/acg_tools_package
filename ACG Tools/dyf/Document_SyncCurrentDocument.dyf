{
  "Uuid": "eab0615c-19be-429f-9657-652d08dcd39b",
  "IsCustomNode": true,
  "Category": "ACG Tools",
  "Description": "Synchronizes the current workshared Revit document with central.",
  "Name": "Document.Sync Current Document",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\nfrom datetime import datetime\n\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\n\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\n\ndef as_bool(value, default=False):\n    if value is None:\n        return default\n    if isinstance(value, bool):\n        return value\n    text = str(value).strip().lower()\n    if text in ('true', '1', 'yes', 'y'):\n        return True\n    if text in ('false', '0', 'no', 'n', ''):\n        return False\n    return bool(value)\n\n\ndef central_path(document):\n    try:\n        model_path = document.GetWorksharingCentralModelPath()\n        if model_path:\n            return ModelPathUtils.ConvertModelPathToUserVisiblePath(model_path)\n    except:\n        pass\n    try:\n        return document.PathName\n    except:\n        return ''\n\n\nrun_it = as_bool(IN[0], False)\ncomment = IN[1] if IN[1] else 'Synced from Dynamo'\nrelinquish_all = as_bool(IN[2], True)\ncompact = as_bool(IN[3], False)\n\ndoc = DocumentManager.Instance.CurrentDBDocument\ndocument_title = doc.Title if doc else ''\ndocument_path = central_path(doc) if doc else ''\nsynced_at = ''\nis_detached = False\n\nif doc:\n    try:\n        is_detached = doc.IsDetached\n    except:\n        is_detached = False\n\nsuccess = False\nmessage = 'Set run_it to true to synchronize the current Revit document.'\n\nif run_it:\n    if doc is None:\n        message = 'No current Revit document was found.'\n    elif not doc.IsWorkshared:\n        message = 'The current Revit document is not workshared and cannot synchronize with central.'\n    elif is_detached:\n        message = 'The current Revit document is detached from central and cannot synchronize.'\n    else:\n        try:\n            # SynchronizeWithCentral must run outside Dynamo/Revit transactions.\n            TransactionManager.Instance.ForceCloseTransaction()\n\n            transact_options = TransactWithCentralOptions()\n            sync_options = SynchronizeWithCentralOptions()\n            sync_options.Comment = str(comment)\n            sync_options.Compact = compact\n            sync_options.SaveLocalBefore = True\n            sync_options.SaveLocalAfter = True\n            sync_options.SetRelinquishOptions(RelinquishOptions(relinquish_all))\n\n            doc.SynchronizeWithCentral(transact_options, sync_options)\n            success = True\n            synced_at = datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n            document_path = central_path(doc)\n            message = 'Synchronized current Revit document with central.'\n        except Exception as err:\n            message = 'Synchronize with central failed: ' + str(err)\n\nOUT = [success, message, document_title, document_path, synced_at]\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "421372d6ae0e43b48eebc9eb639bc6e8",
